# Render: one public origin for the API and built dashboard.
FROM node:24.14.1-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_URL=
RUN npm run build

FROM python:3.13.5-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 libexpat1 \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY backend/ ./
COPY config/ ./config/
COPY data/climatology/ ./data/climatology/
COPY data/models/ ./data/models/
COPY data/reference/ ./data/reference/
COPY data/replay/ ./data/replay/
COPY --from=frontend-build /frontend/dist/ ./frontend_dist/
ENV PORT=8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
