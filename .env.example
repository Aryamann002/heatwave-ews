# Copy to .env (git-ignored). The default local walkthrough uses clearly labelled demo authentication.

# For deployment, change AUTH_MODE to strict, use a random secret of at least 32 characters,
# and supply passwords through the environment. Never commit the populated .env file.
AUTH_MODE=demo
HEATWATCH_SESSION_SECRET=
HEATWATCH_USERS_JSON=

# CAP remains Test until the deploying authority approves its sender and India gateway profile.
CAP_STATUS=Test
CAP_SENDER=heatsafe-demo@example.invalid

# Optional social sign-in. Create each OAuth app yourself and register the exact callback
# at http://localhost:8543/auth/oauth/{provider}/callback for local testing.
# Do not enable providers publicly without HTTPS, approved access policy, and a security review.
PUBLIC_BASE_URL=
HEATSAFE_GOOGLE_CLIENT_ID=
HEATSAFE_GOOGLE_CLIENT_SECRET=
HEATSAFE_GITHUB_CLIENT_ID=
HEATSAFE_GITHUB_CLIENT_SECRET=

# Groq API key: regional-language advisory translation and LLM parsing of dashboard questions.
# Without it, English/Hindi template advisories and keyword query parsing are used.
GROQ_API_KEY=

# Accept a population raster whose checksum differs from the pinned one (see config/vulnerability_source.json).
ALLOW_UNPINNED_POPULATION=0

# Copernicus Climate Data Store (free account): builds all-India 1991-2020 normals
# (python -m pipeline.climatology cds). Accept the licence of "ERA5 post-processed daily statistics" first.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
